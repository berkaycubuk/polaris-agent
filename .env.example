# --- Main LLM (the agent's brain) ----------------------------------------
# Any OpenAI-compatible chat-completions endpoint works.
# This model does NOT need to support vision — image understanding is
# delegated to a separate captioner below.
#
#   OpenAI:   https://api.openai.com/v1            (gpt-4o-mini, gpt-4o, ...)
#   Gemini:   https://generativelanguage.googleapis.com/v1beta/openai
#             models: gemini-2.5-flash-lite, gemini-2.5-flash, gemini-2.5-pro
#   Anthropic-compat / Groq / OpenRouter / local Ollama also work.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-...

# --- Image captioner (optional, but required for image understanding) ----
# A small vision model that turns image attachments into text. Only the
# resulting caption goes into chat history — image bytes never do.
# Set all three or none.
IMAGE_CAPTION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
IMAGE_CAPTION_MODEL=gemini-2.5-flash-lite
IMAGE_CAPTION_API_KEY=

# --- Cloudflare R2 (optional, long-term image storage) -------------------
# When configured, original image bytes are uploaded to R2 and the URL is
# stored alongside the caption so the agent (or you) can fetch the original
# later. R2 endpoint is derived from the account ID; set all four of these
# or none. R2_PUBLIC_BASE_URL is optional and only used to format the URL
# returned to the agent (e.g. https://pub-xxx.r2.dev or your custom domain).
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# --- Telegram (optional) -------------------------------------------------
TELEGRAM_BOT_TOKEN=

# --- Misc ----------------------------------------------------------------
# Required: rotate this yourself to secure the agent.
AUTH_TOKEN=change-me

# Optional: max tool calls per user turn before the agent gives up (default 30).
MAX_TOOL_ITERATIONS=30
